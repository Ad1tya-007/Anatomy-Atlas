# Copy to .env.local. None of these are required for browsing the atlas as a guest.

# AI tutor (Vercel AI Gateway). Omit both and set TUTOR_MOCK=1 to drive the chat UI with a scripted model.
# AI_GATEWAY_API_KEY=
# TUTOR_MODEL=anthropic/claude-haiku-5.5
# TUTOR_EMBEDDING_MODEL=openai/text-embedding-3-small
TUTOR_MOCK=1

# Accounts and progress sync. Only the URL and anon key are forwarded to the browser.
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Optional shared rate limit for /api/tutor. Without these, each function instance counts locally.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
