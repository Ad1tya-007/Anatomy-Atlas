{
  "name": "anatomy-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:vercel": "npm run typecheck && tsx scripts/build-vercel.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "perf": "tsx scripts/perf.ts",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,studio,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db lint --level warning --fail-on warning && supabase test db",
    "db:types": "supabase gen types --lang typescript --schema public > src/features/sync/database.types.ts && prettier --write src/features/sync/database.types.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "eval": "tsx scripts/eval-tutor.ts",
    "tutor:embeddings": "tsx scripts/tutor-embeddings.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.166",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "ai": "^7.0.162",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "ts-fsrs": "^6.0.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "draco3dgltf": "^1.5.9",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.2",
    "lighthouse": "^13.6.0",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.1.0"
  }
}
